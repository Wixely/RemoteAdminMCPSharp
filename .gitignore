# Build output
bin/
obj/
out/
publish/
*.binlog

# Logs (Serilog rolling files)
logs/
*.log

# Local secrets / overrides
appsettings.Development.json
*.Local.json
secrets.json
.env
.env.*

# Live inventory & key material — operators copy the *.example.json templates to these names
# and fill them in. The service auto-encrypts plaintext secrets on first start.
windows_servers.json
linux_servers.json
master.key

