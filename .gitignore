.idea/
*.DotSettings.user
_ReSharper*/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs

# VS Code (keep launch.json/tasks.json/extensions.json/settings.json, ignore the rest)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

